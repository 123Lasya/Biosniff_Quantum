# BIO-SNIFF Prototype Backend Environment Configuration
PROJECT_NAME="BIO-SNIFF IoT Backend"
API_V1_STR="/api"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (MySQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/biosniff_db

# Fallback for local dev/testing without active MySQL server (optional):
# DATABASE_URL=sqlite:///./biosniff.db

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-super-secret-key-in-production-bio-sniff-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Hardware Master ESP32 Gateway Authentication Key
DEVICE_API_KEY=esp32-master-secret-key-99a8b7c6d5e4

# CORS allowed origins (comma separated or JSON array)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
