{
  "info": {
    "name": "Bio-Sniff Part 2 - Hardware Ingestion Pipeline & Telemetry APIs",
    "_postman_id": "biosniff-part2-hardware-pipeline",
    "description": "Complete Postman test collection for the Bio-Sniff Agricultural IoT backend: Hardware authentication, 6-Hour rolling window ingestion, validation edge cases, and telemetry read APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "deviceApiKey",
      "value": "biosniff-master-esp32-hw-key-secure",
      "type": "string"
    },
    {
      "key": "farmId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "nodeId",
      "value": "NODE_01",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Hardware Ingestion (POST /api/sensor-data)",
      "item": [
        {
          "name": "1. Ingest Hour 1 (Baseline 1/5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-API-Key",
                "value": "{{deviceApiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": {{farmId}},\n  \"timestamp\": \"2026-09-12T06:00:00Z\",\n  \"nodes\": [\n    {\n      \"node_id\": \"NODE_01\",\n      \"gas_resistance\": [41.2, 41.5, 41.8, 42.0, 42.3, 42.6, 42.9, 43.1, 43.4, 43.7],\n      \"temperature\": 28.4,\n      \"humidity\": 68.2,\n      \"pressure\": 1008.2,\n      \"battery\": 99.0,\n      \"signal\": -56.0\n    },\n    {\n      \"node_id\": \"NODE_02\",\n      \"gas_resistance\": [40.1, 40.3, 40.5, 40.8, 41.0, 41.2, 41.4, 41.7, 42.0, 42.2],\n      \"temperature\": 28.1,\n      \"humidity\": 69.0,\n      \"pressure\": 1008.1,\n      \"battery\": 98.0,\n      \"signal\": -62.0\n    },\n    {\n      \"node_id\": \"NODE_03\",\n      \"gas_resistance\": [39.8, 40.0, 40.2, 40.5, 40.7, 41.0, 41.2, 41.5, 41.8, 42.0],\n      \"temperature\": 28.6,\n      \"humidity\": 67.5,\n      \"pressure\": 1008.3,\n      \"battery\": 97.0,\n      \"signal\": -65.0\n    }\n  ],\n  \"wind\": {\n    \"average_speed\": 1.8,\n    \"average_direction\": 45.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensor-data",
              "host": ["{{baseUrl}}"],
              "path": ["sensor-data"]
            }
          }
        },
        {
          "name": "2. Ingest Hour 5 (Prediction Ready [C1..C5])",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-API-Key",
                "value": "{{deviceApiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": {{farmId}},\n  \"timestamp\": \"2026-09-12T10:00:00Z\",\n  \"nodes\": [\n    {\n      \"node_id\": \"NODE_01\",\n      \"gas_resistance\": [45.1, 45.4, 45.7, 46.0, 46.3, 46.6, 46.9, 47.2, 47.5, 47.8],\n      \"temperature\": 34.2,\n      \"humidity\": 50.5,\n      \"pressure\": 1005.4,\n      \"battery\": 95.0,\n      \"signal\": -59.0\n    }\n  ],\n  \"wind\": {\n    \"average_speed\": 4.1,\n    \"average_direction\": 125.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensor-data",
              "host": ["{{baseUrl}}"],
              "path": ["sensor-data"]
            }
          }
        },
        {
          "name": "3. Ingest Hour 6 (Rolling Window [C2..C6])",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-API-Key",
                "value": "{{deviceApiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": {{farmId}},\n  \"timestamp\": \"2026-09-12T11:00:00Z\",\n  \"nodes\": [\n    {\n      \"node_id\": \"NODE_01\",\n      \"gas_resistance\": [46.0, 46.3, 46.6, 46.9, 47.2, 47.5, 47.8, 48.1, 48.4, 48.7],\n      \"temperature\": 35.1,\n      \"humidity\": 47.0,\n      \"pressure\": 1004.8,\n      \"battery\": 94.0,\n      \"signal\": -59.0\n    }\n  ],\n  \"wind\": {\n    \"average_speed\": 4.6,\n    \"average_direction\": 135.0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensor-data",
              "host": ["{{baseUrl}}"],
              "path": ["sensor-data"]
            }
          }
        },
        {
          "name": "4. Test Partial Success (1 Node Malformed, 2 Valid)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Device-API-Key",
                "value": "{{deviceApiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"farm_id\": {{farmId}},\n  \"timestamp\": \"2026-09-12T12:00:00Z\",\n  \"nodes\": [\n    {\n      \"node_id\": \"NODE_01\",\n      \"gas_resistance\": [41.2, 41.5, 41.8, 42.0, 42.3, 42.6, 42.9, 43.1, 43.4, 43.7],\n      \"temperature\": 31.5,\n      \"humidity\": 55.0,\n      \"pressure\": 1005.2\n    },\n    {\n      \"node_id\": \"NODE_02\",\n      \"gas_resistance\": [40.1, 40.2],\n      \"temperature\": 30.8,\n      \"humidity\": 56.1,\n      \"pressure\": 1005.0\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensor-data",
              "host": ["{{baseUrl}}"],
              "path": ["sensor-data"]
            }
          }
        }
      ]
    },
    {
      "name": "Read APIs (Frontend Consumption)",
      "item": [
        {
          "name": "Get Node Sensor History & 5-Hour Window",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/nodes/{{nodeId}}/sensor-history?limit=20&only_valid=false",
              "host": ["{{baseUrl}}"],
              "path": ["nodes", "{{nodeId}}", "sensor-history"],
              "query": [
                {"key": "limit", "value": "20"},
                {"key": "only_valid", "value": "false"}
              ]
            }
          }
        },
        {
          "name": "Get Farm Microclimate & Node Averages",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/farms/{{farmId}}/environment",
              "host": ["{{baseUrl}}"],
              "path": ["farms", "{{farmId}}", "environment"]
            }
          }
        },
        {
          "name": "Get Farm Environment History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/farms/{{farmId}}/environment/history?limit=48",
              "host": ["{{baseUrl}}"],
              "path": ["farms", "{{farmId}}", "environment", "history"],
              "query": [
                {"key": "limit", "value": "48"}
              ]
            }
          }
        }
      ]
    }
  ]
}
